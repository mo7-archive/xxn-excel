{
  "compilerOptions": {
    "target": "es2022",
    "module": "NodeNext",
    "allowJs": true,
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "outDir": "./dist"
  },
  "include": ["**/*.ts", "**/*.js", "**/*.vue"],
  "exclude": ["node_modules", "dist", "build"]
}
